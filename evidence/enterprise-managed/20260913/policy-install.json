      "/etc/kirocrew-demo/security-policy.json": {
        "content": "{\n  \"approval_modes\": {\n    \"deny\": [\n      \"yolo\"\n    ],\n    \"mode\": \"deny\"\n  },\n  \"boot\": {},\n  \"commands\": {\n    \"deny\": [\n      \"*KIROCREW_MANAGED_COMMAND_CONTROL*\",\n      \"aws(?:\\\\s+--?[a-z-]+(?:[= ]\\\\S+)?)*\\\\s+s3(?:\\\\s+--?[a-z-]+(?:[= ]\\\\S+)?)*\\\\s+cp .* s3://.*\"\n    ],\n    \"mode\": \"deny\"\n  },\n  \"filesystem\": {\n    \"read\": {\n      \"deny\": [\n        \"/home/crew/.aws\",\n        \"/home/crew/.aws/**\"\n      ],\n      \"mode\": \"deny\"\n    },\n    \"write\": {\n      \"deny\": [\n        \"/etc/kirocrew-demo\",\n        \"/etc/kirocrew-demo/**\",\n        \"/etc/systemd/system\",\n        \"/etc/systemd/system/**\",\n        \"/opt/kirocrew/venv/lib/python3.12/site-packages/kiro_crew\",\n        \"/opt/kirocrew/venv/lib/python3.12/site-packages/kiro_crew/**\",\n        \"/home/crew/.kiro/agents\",\n        \"/home/crew/.kiro/agents/**\"\n      ],\n      \"mode\": \"deny\"\n    }\n  },\n  \"mcp\": {\n    \"deny\": [\n      \"@aws-enforcement/crew_denied\"\n    ],\n    \"mode\": \"deny\"\n  },\n  \"sandbox\": {\n    \"min_level\": \"cc\"\n  },\n  \"version\": 1\n}\n",
        "mode": "0o644",
        "sha256": "ca6c7e60f5afe4c75ac4c996ed9b9ee1bb4dfaa9031ae777260027bbc9302f87"
